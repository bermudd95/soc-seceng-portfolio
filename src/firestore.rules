rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for user authentication check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Tenant Isolation Helper
    function isTenantMember(tenantId) {
      return isAuthenticated() && request.auth.token.tenantId == tenantId;
    }

    // Public Threat Intel Data (Read Only)
    match /cisa_kev/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Multi-tenant SentinelGRC Compliance Collections
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if isTenantMember(tenantId);
    }

    // Audit Logging Collection (Immutable Log Rule)
    match /audit_logs/{logId} {
      allow create: if isAuthenticated() 
        && request.resource.data.actorId == request.auth.uid;
      allow read: if isAuthenticated();
      allow update, delete: if false; // Deny modifications to enforce audit integrity
    }
  }
}